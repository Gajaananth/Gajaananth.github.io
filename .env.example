# EmailJS configuration for the Contact form (src/sections/Contact.tsx)
# Copy this file to .env and fill in your own values from
# https://dashboard.emailjs.com/admin
#
# If these are left unset, the form falls back to the previously
# hardcoded credentials so it keeps working out of the box.

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_NOTIFY=
VITE_EMAILJS_TEMPLATE_AUTOREPLY=
